{
  "format": 1,
  "id": "dafin.instant-underline",
  "label": "Instant + Underline",
  "description": "The text is there from the first frame; an underline draws itself in underneath.",
  "category": "text-accents",
  "tags": ["instant", "underline", "clean", "tutorial"],
  "sampleText": "Step one",
  "requires": { "fonts": ["Inter"] },
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 700,
    "pixelSize": 96,
    "layers": [
      { "id": "shadow", "kind": "shadow", "paint": { "kind": "solid", "color": "#000000" },
        "offsetX": 0, "offsetY": 4, "blur": 10, "opacity": 0.45 },
      { "id": "fill", "kind": "fill", "paint": { "kind": "solid", "color": "#ffffff" } }
    ],
    "underlineEnabled": true,
    "underlineColor": "#ffcc00",
    "underlineWidth": 10,
    "underlineOffset": 14,
    "keyframes": {
      "underlineReveal": { "keyframes": [ { "timeUs": 0, "value": 0 }, { "timeUs": 350000, "value": 1 } ] }
    }
  },
  "controls": [
    { "id": "text", "label": "Text", "type": "text", "bind": "text" },
    { "id": "font", "label": "Font", "type": "font", "bind": "font.family" },
    { "id": "color", "label": "Text colour", "type": "color", "bind": "layer.fill.color" },
    { "id": "lineColor", "label": "Underline colour", "type": "color", "bind": "underline.color" },
    { "id": "lineWidth", "label": "Underline thickness", "type": "scalar", "bind": "underlineWidth", "min": 2, "max": 30, "step": 1, "unit": "px" },
    { "id": "shadow", "label": "Shadow", "type": "bool", "bind": "layer.shadow.enabled" }
  ]
}
