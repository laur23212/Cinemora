{
  "format": 1,
  "id": "dafin.static-title",
  "label": "Static Title",
  "description": "No animation at all: font, size, colour, outline and shadow, ready to restyle.",
  "category": "titles",
  "tags": ["static", "simple", "clean"],
  "sampleText": "Title",
  "requires": { "fonts": ["Inter"] },
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 700,
    "pixelSize": 100,
    "layers": [
      { "id": "shadow", "kind": "shadow", "paint": { "kind": "solid", "color": "#000000" },
        "offsetX": 3, "offsetY": 5, "blur": 8, "opacity": 0.5 },
      { "id": "stroke", "kind": "stroke", "paint": { "kind": "solid", "color": "#000000" },
        "width": 4, "strokeAlign": "outside" },
      { "id": "fill", "kind": "fill", "paint": { "kind": "solid", "color": "#ffffff" } }
    ]
  },
  "controls": [
    { "id": "text", "label": "Text", "type": "text", "bind": "text" },
    { "id": "font", "label": "Font", "type": "font", "bind": "font.family" },
    { "id": "weight", "label": "Weight", "type": "scalar", "bind": "font.weight", "min": 100, "max": 900, "step": 100 },
    { "id": "size", "label": "Size", "type": "scalar", "bind": "font.size", "min": 16, "max": 300, "step": 1, "unit": "px" },
    { "id": "color", "label": "Text colour", "type": "color", "bind": "layer.fill.color" },
    { "id": "outline", "label": "Outline", "type": "bool", "bind": "layer.stroke.enabled" },
    { "id": "outlineColor", "label": "Outline colour", "type": "color", "bind": "layer.stroke.color" },
    { "id": "outlineWidth", "label": "Outline width", "type": "scalar", "bind": "layer.stroke.width", "min": 0, "max": 20, "step": 0.5, "unit": "px" },
    { "id": "shadow", "label": "Shadow", "type": "bool", "bind": "layer.shadow.enabled" },
    { "id": "shadowBlur", "label": "Shadow softness", "type": "scalar", "bind": "layer.shadow.blur", "min": 0, "max": 40, "step": 1, "unit": "px", "group": "Shadow" }
  ]
}
